generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  login    String?
  email    String  @unique
  password String
  profile Profile?
  dailyMeals DailyMeal[]
}

model Profile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
  name          String?
  age           Int?
  height        Float?
  weight        Float?
  gender        String?
  activityLevel String?
  goal          String?
  dailyCalories Int?
  protein       Int?
  fat           Int?
  carbs         Int?
}

model Recipe {
  id          String  @id @default(uuid())
  name        String
  description String?

  ingredients RecipeIngredient[]
  dailyMealItems DailyMealItem[] 
}

model Ingredient {
  id String  @id @default(uuid())
  name String
  calories    Int
  protein     Int
  fat         Int
  carbs       Int

  recipes RecipeIngredient[]
}

model RecipeIngredient {
  id String  @id @default(uuid())
  recipeId  String
  ingredientId String
  mass Int

  recipe Recipe @relation(fields: [recipeId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model DailyMeal {
  id String  @id @default(uuid())
  userId String
  date DateTime

  items DailyMealItem[]

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model DailyMealItem {
  id String  @id @default(uuid())
  dailyMealId String
  recipeId String
  type MealType

  dailyMeal DailyMeal @relation(fields: [dailyMealId], references: [id])
  recipe Recipe @relation(fields: [recipeId], references: [id])
}
